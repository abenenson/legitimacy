    "claude-agent-sdk-python/src/claude_agent_sdk/types.py::ClaudeAgentOptions": {
      "Binary": {
        "id": "claude-agent-sdk-python/src/claude_agent_sdk/types.py::ClaudeAgentOptions",
        "name": "claude-agent-sdk-python/src/claude_agent_sdk/types.py::ClaudeAgentOptions:1452-1769",
        "gates": [
          {
            "ContentMatch": {
              "regex": "Query options for Claude SDK\\.",
              "decision": "Escalate"
            }
          },
          {
            "ContentMatch": {
              "regex": "Specify the base set of available built\\-in tools\\.\n\n    \\- ``list\\[str\\]`` — Specific tool names \\(e\\.g\\. ``\\[\"Bash\", \"Read\", \"Edit\"\\]``\\)\\.\n    \\- ``\\[\\]`` \\(empty list\\) — Disable all built\\-in tools\\.\n    \\- ``\\{\"type\": \"preset\", \"preset\": \"claude_code\"\\}`` — Use all default Claude Code tools\\.\n\n    To restrict which tools the model may call without being prompted, use\n    ``allowed_tools`` instead\\.",
              "decision": "Permit"
            }
          },
          {
            "ContentMatch": {
              "regex": "Tool names that are auto\\-allowed without prompting for permission\\.\n\n    These tools execute automatically without asking the user for approval\\.\n    To restrict which tools are available at all, use ``tools``\\.",
              "decision": "Permit"
            }
          },
          {
            "ContentMatch": {
              "regex": "System prompt configuration\\.\n\n    \\- ``str`` — Use a custom system prompt\\.\n    \\- ``\\{\"type\": \"preset\", \"preset\": \"claude_code\"\\}`` — Use Claude Code's default\n      system prompt\\.\n    \\- ``\\{\"type\": \"preset\", \"preset\": \"claude_code\", \"append\": \"\\.\\.\\.\"\\}`` — Default\n      prompt with appended instructions\\.",
              "decision": "Escalate"
            }
          },
          {
            "ContentMatch": {
              "regex": "MCP \\(Model Context Protocol\\) server configurations\\.\n\n    Keys are server names, values are server configurations\\. May also be a path\n    to an MCP config JSON file\\.",
              "decision": "Escalate"
            }
          },
          {
            "ContentMatch": {
              "regex": "Permission mode for the session\\.\n\n    \\- ``\"default\"`` — Standard permission behavior; prompts for dangerous operations\\.\n    \\- ``\"acceptEdits\"`` — Auto\\-accept file edit operations\\.\n    \\- ``\"bypassPermissions\"`` — Bypass all permission checks\\.\n    \\- ``\"plan\"`` — Planning mode, no execution of tools\\.\n    \\- ``\"dontAsk\"`` — Don't prompt for permissions; deny if not pre\\-approved\\.",
              "decision": "Escalate"
            }
          },
          {
            "ContentMatch": {
              "regex": "Continue the most recent conversation in the current directory instead of\n    starting a new one\\. Mutually exclusive with ``resume``\\.",
              "decision": "Escalate"
            }
          },
          {
            "ContentMatch": {
              "regex": "Session ID to resume\\. Loads the conversation history from the specified session\\.",
              "decision": "Escalate"
            }
          },
          {
            "ThresholdGate": {
              "field": "hook_registration",
              "min": 1.0,
              "decision": "Escalate"
            }
          }
        ],
        "default": "Permit",
        "combination": "FirstMatch"
      }
    },
