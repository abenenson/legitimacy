    "claude-agent-sdk-python/src/claude_agent_sdk/client.py::set_permission_mode": {
      "Binary": {
        "id": "claude-agent-sdk-python/src/claude_agent_sdk/client.py::set_permission_mode",
        "name": "claude-agent-sdk-python/src/claude_agent_sdk/client.py::set_permission_mode:318-343",
        "gates": [
          {
            "ContentMatch": {
              "regex": "Change permission mode during conversation \\(only works with streaming mode\\)\\.\n\n        Args:\n            mode: The permission mode to set\\. Valid options:\n                \\- 'default': CLI prompts for dangerous tools\n                \\- 'acceptEdits': Auto\\-accept file edits\n                \\- 'plan': Plan\\-only mode \\(no tool execution\\)\n                \\- 'bypassPermissions': Allow all tools \\(use with caution\\)\n                \\- 'dontAsk': Deny anything not pre\\-approved by allow rules\n                \\- 'auto': A model classifier approves or denies each tool call\n\n        Example:\n            ```python\n            async with ClaudeSDKClient\\(\\) as client:\n                \\# Start with default permissions\n                await client\\.query\\(\"Help me analyze this codebase\"\\)\n\n                \\# Review mode done, switch to auto\\-accept edits\n                await client\\.set_permission_mode\\('acceptEdits'\\)\n                await client\\.query\\(\"Now implement the fix we discussed\"\\)\n            ```",
              "decision": "Escalate"
            }
          },
          {
            "ContentMatch": {
              "regex": "Not connected\\. Call connect\\(\\) first\\.",
              "decision": "Escalate"
            }
          }
        ],
        "default": "Permit",
        "combination": "FirstMatch"
      }
    },
