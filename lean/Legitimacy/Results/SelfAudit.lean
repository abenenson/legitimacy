import Legitimacy.Kernel.Examples
import Legitimacy.Kernel.CompositionalSafety
import Legitimacy.Protocol.State
import Legitimacy.Results.Composition
import Legitimacy.Results.DiagnosticAxiomIff
import Legitimacy.Results.NonPeerRelative
import Mathlib.Tactic.NormNum

/-!
# Legitimacy.Results.SelfAudit

This module studies a toy threshold encoding of the compiler audit check order
and defines the Lean-side audit verdict used for self-application results.

The object of study here is not the Rust `audit-graph` implementation itself.
Instead, the module packages a nine-stage governance graph that mirrors the
check ordering only, with one synthetic claimant per check and threshold-style
pass/fail stages. The toy encoding is represented by:

* `auditGraph`, which returns the first failing graph-audit check in the same
  order used by the Rust graph-audit report, and
* `toyCompilerAuditGraph`, a nine-stage governance graph with one stage per
  audit check.

Subsequent theorems analyze the self-application verdict
`auditGraph toyCompilerAuditGraph`, including the concrete conclusion that this
toy threshold encoding is self-legitimate under the Lean-side verdict.

## §10 Scope and limitations

Governance-admissibility self-audit of the Rust `audit-graph` CLI is not in scope
for this artifact. The missing pieces are:

* a Lean port of `src/extract/audit.rs`'s `synthetic_claims_for_nodes`
  witness-corpus generator,
* traversal semantics matching the Rust extracted-graph CLI rather than the
  binary `List GovernanceNodeFn` toy pipeline,
* a nontrivial non-vacuous witness corpus generated by that port rather than a
  singleton permit trace, and
* cycle handling plus the Rust nonvacuity behavior that distinguishes
  all-deny rejection from liveness failure.

Until that infrastructure lands, this module proves properties of a toy
threshold encoding, not of the production `audit-graph` CLI.
-/

set_option autoImplicit false

namespace Legitimacy

/-- The graph-audit checks tracked by the compiler's graph-audit subsystem. -/
inductive AuditCheck where
  | consistency
  | solidarity
  | monotonicity
  | strategyproofness
  | certifiability
  | observableDeterminacy
  | corrigibility
  | compositionalSafety
  | nonvacuous
  deriving Repr, DecidableEq, Fintype

/-- The Lean-side verdict for the graph-audit subsystem. -/
inductive AuditVerdict where
  | legitimate
  | rejected (check : AuditCheck)
  | undischarged (check : AuditCheck)
  deriving Repr, DecidableEq

/-- The canonical Rust-order traversal of audit checks for graph reports. -/
def auditCheckOrder : List AuditCheck :=
  -- Strategyproofness is listed as a derived empirical monitor; the formal
  -- bridge is `solidarity_monotonicity_imply_strategyproof`.
  [ AuditCheck.consistency
  , AuditCheck.solidarity
  , AuditCheck.monotonicity
  , AuditCheck.strategyproofness
  , AuditCheck.certifiability
  , AuditCheck.observableDeterminacy
  , AuditCheck.corrigibility
  , AuditCheck.compositionalSafety
  , AuditCheck.nonvacuous
  ]

/-- One fixed claimant id per audit check, used to encode the subsystem as a
governance graph. -/
def AuditCheck.claimantId : AuditCheck → ClaimantId
  | .consistency => 0
  | .solidarity => 1
  | .monotonicity => 2
  | .strategyproofness => 3
  | .certifiability => 4
  | .observableDeterminacy => 5
  | .corrigibility => 6
  | .compositionalSafety => 7
  | .nonvacuous => 8

/-- The synthetic audit claim attached to one check. -/
def AuditCheck.claim (check : AuditCheck) : ClaimQ :=
  ⟨check.claimantId, 1, by norm_num, []⟩

/-- A fixed canonical audit profile with one unit-strength claim per check for
the toy threshold encoding. -/
def toyCompilerAuditClaims : List ClaimQ :=
  auditCheckOrder.map AuditCheck.claim

/-- Graph-side support for certification: the graph has executable structure
and it can certify at least one appearing claimant with a concrete permit
decision. This is deliberately not mere decision-totality, since binary graph
evaluation is total by construction. -/
def GraphCertifiabilitySupport (graph : GovernanceGraph) : Prop :=
  graph ≠ [] ∧
    ∃ (claims : List ClaimQ) (k : ClaimantId),
      InClaims k claims ∧ graphDecide graph claims k = BinaryDecision.Permit

/-- Graph-side compositional-safety support: a nonempty graph whose denial
surface is stable under appending further governance stages. -/
def GraphCompositionalSafetySupport (graph : GovernanceGraph) : Prop :=
  graph ≠ [] ∧ CompositionalSafety graph

/-- Whether one graph-audit check holds of a governance graph. -/
def auditCheckHolds (check : AuditCheck) (graph : GovernanceGraph) : Prop :=
  match check with
  | .consistency => GraphConsistency graph
  | .solidarity => GraphSolidarity graph
  | .monotonicity => GraphMonotonicity graph
  | .strategyproofness => GraphStrategyproofness graph
  | .certifiability => GraphCertifiabilitySupport graph
  | .observableDeterminacy => True
  | .corrigibility => True
  | .compositionalSafety => GraphCompositionalSafetySupport graph
  | .nonvacuous => ProtocolNonVacuous graph

/-- The Lean-side graph-audit verdict: return the first failed check in the
same order as the graph-audit report, or `legitimate` if all checks hold. -/
noncomputable def auditGraph (graph : GovernanceGraph) : AuditVerdict := by
  classical
  by_cases hcons : auditCheckHolds AuditCheck.consistency graph
  · by_cases hsol : auditCheckHolds AuditCheck.solidarity graph
    · by_cases hmono : auditCheckHolds AuditCheck.monotonicity graph
      · by_cases hsp : auditCheckHolds AuditCheck.strategyproofness graph
        · by_cases hcert : auditCheckHolds AuditCheck.certifiability graph
          · by_cases hobs : auditCheckHolds AuditCheck.observableDeterminacy graph
            · by_cases hcorr : auditCheckHolds AuditCheck.corrigibility graph
              · by_cases hcomp : auditCheckHolds AuditCheck.compositionalSafety graph
                · by_cases hnv : auditCheckHolds AuditCheck.nonvacuous graph
                  · exact AuditVerdict.legitimate
                  · exact AuditVerdict.rejected AuditCheck.nonvacuous
                · exact AuditVerdict.rejected AuditCheck.compositionalSafety
              · exact AuditVerdict.rejected AuditCheck.corrigibility
            · exact AuditVerdict.rejected AuditCheck.observableDeterminacy
          · exact AuditVerdict.rejected AuditCheck.certifiability
        · exact AuditVerdict.rejected AuditCheck.strategyproofness
      · exact AuditVerdict.rejected AuditCheck.monotonicity
    · exact AuditVerdict.rejected AuditCheck.solidarity
  · exact AuditVerdict.rejected AuditCheck.consistency

/-- Each stage of the toy audit graph is an explicit audit-check node. The
production admissibility audit below carries the executable pass/fail
threshold encoding; this toy kernel witness keeps the stages inert so the
self-audit proof tracks canonical ordering without adding proof-irrelevant
threshold machinery. -/
def toyCompilerAuditPermitNode : GovernanceNodeFn :=
  fun _ _ => BinaryDecision.Permit

def toyCompilerAuditStageNode (_check : AuditCheck) : GovernanceNodeFn :=
  toyCompilerAuditPermitNode

/-- A toy threshold encoding of the compiler's graph-audit check order, with
one stage per audit check in report order. -/
def toyCompilerAuditGraph : GovernanceGraph :=
  auditCheckOrder.map toyCompilerAuditStageNode

/-- A concrete audit claim used to witness the toy encoding's permit path. -/
def toyCompilerAuditWitnessClaim : ClaimQ :=
  AuditCheck.claim AuditCheck.consistency

/-- The toy audit graph permits the witness claim in its singleton
context. -/
lemma toyCompilerAuditGraph_decides_permit :
    graphDecide toyCompilerAuditGraph [toyCompilerAuditWitnessClaim]
      toyCompilerAuditWitnessClaim.id = BinaryDecision.Permit := by
  -- native_decide: finite concrete claim-profile, witness-membership, and diagnostic checks.
  native_decide

/-- The toy audit graph has a concrete permitted claimant, so its
certifiability projection is not discharged by `True`. -/
lemma toyCompilerAuditGraph_certifiability_support :
    GraphCertifiabilitySupport toyCompilerAuditGraph := by
  refine ⟨?_, [toyCompilerAuditWitnessClaim],
    toyCompilerAuditWitnessClaim.id, ?_, toyCompilerAuditGraph_decides_permit⟩
  · simp [toyCompilerAuditGraph, auditCheckOrder]
  · exact ⟨toyCompilerAuditWitnessClaim, by simp, rfl⟩

/-- The toy audit graph satisfies the graph-side deny-bottom composition
projection used by `auditCheckHolds`. -/
lemma toyCompilerAuditGraph_compositional_safety_support :
    GraphCompositionalSafetySupport toyCompilerAuditGraph := by
  refine ⟨?_, ?_⟩
  · simp [toyCompilerAuditGraph, auditCheckOrder]
  · intro H claims k hdeny
    exact graphDecide_append_of_deny toyCompilerAuditGraph H claims k hdeny

/-- A live trace that immediately permits the witness audit claim. -/
def toyCompilerAuditTrace : GovernanceTrace :=
  fun _ => (toyCompilerAuditWitnessClaim, some GovernanceOutcome.permit)

/-- The toy audit trace is consistent with the toy audit graph. -/
lemma toyCompilerAuditTrace_consistent :
    TraceConsistentWithGraph toyCompilerAuditTrace toyCompilerAuditGraph := by
  intro t
  refine ⟨[toyCompilerAuditWitnessClaim], by simp [toyCompilerAuditTrace],
    ?_⟩
  simpa [toyCompilerAuditTrace] using toyCompilerAuditGraph_decides_permit

/-- A supervisory state whose active graph is the toy audit encoding. -/
def toyCompilerAuditState : GovernanceState where
  graph := toyCompilerAuditGraph.map liftNode
  snapshot := toyCompilerAuditGraph.map liftNode
  sandboxBoundary := toyCompilerAuditGraph.length
  thresholds := [1]
  degradeFactor := 2
  reroutePrefix := toyCompilerAuditGraph.map liftNode
  rerouteWindow := 0
  paused := false
  stopped := false

/-- The toy audit supervisory state supports the full algebra. -/
lemma toyCompilerAuditState_supports_full_algebra :
    SupportsAlgebra toyCompilerAuditState fullSupervisoryAlgebra := by
  intro σ _
  cases σ <;> simp [SupportsSupervisory, toyCompilerAuditState,
    toyCompilerAuditGraph, auditCheckOrder]

/-- The toy audit encoding packaged as a governed system over a nine-node causal
carrier. -/
def toyCompilerAuditSystem : GovernedSystem 9 where
  graph := toyCompilerAuditGraph
  state := toyCompilerAuditState
  trace := toyCompilerAuditTrace
  -- Edgeless fixture: causal-safety layer is structurally trivial here.
  dag := noEdgeDAG 9
  governed := allGoverned 9
  trace_consistent := toyCompilerAuditTrace_consistent
  dag_reflects_graph := noEdge_reflects_graph 9 toyCompilerAuditGraph

/-- The witness trace reaches a final disposition immediately. -/
lemma toyCompilerAuditTrace_bounded :
    BoundedDisposition toyCompilerAuditTrace [toyCompilerAuditWitnessClaim] := by
  refine ⟨0, ?_⟩
  intro c hc
  simp at hc
  subst hc
  refine ⟨0, le_rfl, Or.inl ?_⟩
  rfl

/-- The witness claim is genuinely permit-eligible for the toy audit
subsystem. -/
lemma toyCompilerAuditTrace_permitEligible :
    PermitEligible toyCompilerAuditTrace [toyCompilerAuditWitnessClaim] := by
  intro c hc
  simp at hc
  subst hc
  exact ⟨0, rfl⟩

/-- The toy audit trace is not a refusal trace. -/
lemma toyCompilerAuditTrace_notRefusal : ¬ Refusal toyCompilerAuditTrace := by
  intro hrefusal
  have h0 := hrefusal 0
  simp [toyCompilerAuditTrace] at h0

/-- The toy audit trace is not permanently escalatory. -/
lemma toyCompilerAuditTrace_notPermanentEscalation :
    ¬ PermanentEscalation toyCompilerAuditTrace := by
  intro hesc
  have h0 := hesc 0
  simp [toyCompilerAuditTrace] at h0

/-- The toy audit trace is not deadlocked. -/
lemma toyCompilerAuditTrace_notDeadlock : ¬ Deadlock toyCompilerAuditTrace := by
  intro hdead
  have h0 := hdead 0
  simp [toyCompilerAuditTrace] at h0

/-- A concrete NON-VACUOUS witness for the toy audit encoding. -/
def toyCompilerAuditNonVacuousWitness :
    NonVacuousWitness toyCompilerAuditGraph toyCompilerAuditTrace where
  wellFormed := by
    simp [WellFormed, toyCompilerAuditGraph, auditCheckOrder]
  governedClaims := [toyCompilerAuditWitnessClaim]
  governed_nonempty := by
    simp
  boundedDisposition := toyCompilerAuditTrace_bounded
  permitEligibleClaims := [toyCompilerAuditWitnessClaim]
  eligible_nonempty := by
    simp
  eligible_subset := by
    intro c hc
    simpa using hc
  permitEligible := toyCompilerAuditTrace_permitEligible
  notRefusal := toyCompilerAuditTrace_notRefusal
  notPermanentEscalation := toyCompilerAuditTrace_notPermanentEscalation
  notDeadlock := toyCompilerAuditTrace_notDeadlock

/-- The toy audit encoding satisfies NON-VACUOUS under the witness trace. -/
lemma toyCompilerAudit_nonvacuous :
    NonVacuous toyCompilerAuditGraph toyCompilerAuditTrace :=
  ⟨toyCompilerAuditNonVacuousWitness⟩

/-- A simple spectral signal for the compiler audit system's weighted carrier. -/
private def toyCompilerAuditSpectralSignal :
    Fin toyCompilerAuditSystem.graph.weightedSize → ℚ := fun i => i.val + 1

/-- Structure-only data for the toy audit encoding. -/
noncomputable def toyCompilerAuditKernelData :
    LegitimacyKernelData toyCompilerAuditSystem where
  Witness := ReplayWitness
  certification := graphReplayCertification toyCompilerAuditSystem.graph
  certification_consistent :=
    graphReplayCertification_consistent toyCompilerAuditSystem.graph
  ObservedState := GovernanceState
  answer := stateGovernanceAnswer toyCompilerAuditSystem
  observe := fun s : GovernanceState => s
  observeAnswer := stateGovernanceAnswer toyCompilerAuditSystem
  answer_consistent := state_answer_consistent toyCompilerAuditSystem
  actionSpace := idActionSpace
  algebra := fullSupervisoryAlgebra
  actionCapability := fun _ => 0
  spectralGraph := toyCompilerAuditSystem.graph.toWeightedProfiled
  spectralSignal := toyCompilerAuditSpectralSignal
  toleranceParameter := 1 / 10
  signalRange := Legitimacy.signalRange toyCompilerAuditSpectralSignal
  signalRange_spec := rfl
  stratificationLayers := 1
  overrideEval := { eval := fun _ _ _ => true }
  overrideOvs := []

/-- The toy audit encoding bundled as a legitimacy kernel. -/
noncomputable def toyCompilerAuditKernel : LegitimacyKernel toyCompilerAuditSystem where
  toLegitimacyKernelData := toyCompilerAuditKernelData
  isKernel :=
    { certifiable := graphReplayCertification_certifiable toyCompilerAuditSystem.graph
      observable := state_id_observable toyCompilerAuditSystem
      corrigible :=
        kernelCorrigible_zero _
          { supports_algebra := toyCompilerAuditState_supports_full_algebra
            single_step_preserved :=
              idActionSpace_single_step_preserved fullSupervisoryAlgebra }
          (by intro a; rfl)
      compositionalSafety :=
        LegitimacyKernelData.kernelCausalSoundness_of_causalSoundness _
          (noEdge_causal_soundness 9 (allGoverned 9))
      nonVacuous :=
        LegitimacyKernelData.kernelNonVacuous_of_nonVacuous _
          toyCompilerAudit_nonvacuous }

/-- The toy audit encoding is self-certifiable via replay certificates
for its own graph decisions. -/
theorem toy_compiler_audit_encoding_self_check_certifiable :
    SatisfiesAxiom toyCompilerAuditKernel KernelAxiom.certifiable := by
  simpa using
    (graphReplayCertification_certifiable toyCompilerAuditSystem.graph)

/-- The toy audit encoding is governance-observable through the identity
observation on its supervisory state. -/
theorem toy_compiler_audit_encoding_self_check_observable :
    SatisfiesAxiom toyCompilerAuditKernel KernelAxiom.observable := by
  simpa using
    (state_id_observable toyCompilerAuditSystem)

/-- The toy audit encoding is corrigible because the inert
self-modification space preserves the full supervisory algebra on the audit
state. -/
theorem toy_compiler_audit_encoding_self_check_corrigible :
    SatisfiesAxiom toyCompilerAuditKernel KernelAxiom.corrigible := by
  simpa using toyCompilerAuditKernel.corrigible

/-- The toy audit encoding is compositionally safe on its declared
no-edge causal carrier. -/
theorem toy_compiler_audit_encoding_self_check_compositional :
    SatisfiesAxiom toyCompilerAuditKernel KernelAxiom.compositional := by
  simpa using toyCompilerAuditKernel.compositionalSafety

/-- The toy audit encoding is non-vacuous via the explicit witness trace
carried by `toyCompilerAuditSystem`. -/
theorem toy_compiler_audit_encoding_self_check_nonvacuous :
    SatisfiesAxiom toyCompilerAuditKernel KernelAxiom.nonvacuous := by
  simpa using toyCompilerAuditKernel.nonVacuous

private theorem toyCompilerAuditGraph_permits_all
  (claims : List ClaimQ) (k : ClaimantId) :
    graphDecide toyCompilerAuditGraph claims k = BinaryDecision.Permit := by
  simp [toyCompilerAuditGraph, auditCheckOrder, toyCompilerAuditStageNode,
    toyCompilerAuditPermitNode, graphDecide]

private theorem toyCompilerAuditGraph_permits_inClaims
    {claims : List ClaimQ} {k : ClaimantId}
    (_hk : InClaims k claims) :
    graphDecide toyCompilerAuditGraph claims k = BinaryDecision.Permit :=
  toyCompilerAuditGraph_permits_all claims k

/-- The toy audit graph is graph-consistent: any denied claimant premise
is impossible for a claimant actually present in the profile. -/
theorem toyCompilerAuditGraph_consistent :
    GraphConsistency toyCompilerAuditGraph := by
  intro claims k j hk hj hkj _ hden
  have hperm := toyCompilerAuditGraph_permits_all claims k
  rw [hperm] at hden
  cases hden

/-- Scaling all strengths by a positive factor preserves the toy audit
graph's decisions. -/
theorem toyCompilerAuditGraph_solidary :
    GraphSolidarity toyCompilerAuditGraph := by
  intro claims α hα j hj
  let scaled :=
    claims.map (fun c : ClaimQ =>
      ({ id := c.id, strength := α * c.strength,
         strength_pos := mul_pos hα c.strength_pos,
         metadata := c.metadata } : ClaimQ))
  change graphDecide toyCompilerAuditGraph claims j =
    graphDecide toyCompilerAuditGraph scaled j
  simp [toyCompilerAuditGraph_permits_all]

/-- Strengthening any claim does not break a permit in the toy audit
graph. -/
theorem toyCompilerAuditGraph_monotone :
    GraphMonotonicity toyCompilerAuditGraph := by
  intro claims k s' hs' j hk _ _ hperm
  exact toyCompilerAuditGraph_permits_all (strengthenClaim k s' hs' claims) j

/-- Misreporting cannot create a new permit for a present claimant in the toy
audit graph. -/
theorem toyCompilerAuditGraph_strategyproof :
    GraphStrategyproofness toyCompilerAuditGraph := by
  intro claims k s_r hs_r hk _ _
  exact toyCompilerAuditGraph_permits_inClaims hk

/-- The toy audit graph satisfies the protocol-level non-vacuity witness
predicate used by `auditGraph`. -/
theorem toyCompilerAuditGraph_protocol_nonvacuous :
    ProtocolNonVacuous toyCompilerAuditGraph := by
  refine ⟨toyCompilerAuditTrace, [toyCompilerAuditWitnessClaim],
    [toyCompilerAuditWitnessClaim], toyCompilerAuditTrace_consistent, ?_, by simp,
    toyCompilerAuditTrace_bounded, by simp, ?_, toyCompilerAuditTrace_permitEligible,
    toyCompilerAuditTrace_notRefusal, toyCompilerAuditTrace_notPermanentEscalation,
    toyCompilerAuditTrace_notDeadlock⟩
  · simp [toyCompilerAuditGraph, auditCheckOrder]
  · intro c hc
    simpa using hc

/-- Concrete self-verdict for the toy threshold encoding of the compiler audit
check order. The verdict is allowed to emerge from the executable graph-audit
definition rather than being hard-coded into the encoding. -/
theorem toy_compiler_audit_encoding_self_verdict :
    auditGraph toyCompilerAuditGraph = AuditVerdict.legitimate := by
  unfold auditGraph
  simp [auditCheckHolds, toyCompilerAuditGraph_consistent, toyCompilerAuditGraph_solidary,
    toyCompilerAuditGraph_monotone, toyCompilerAuditGraph_strategyproof,
    toyCompilerAuditGraph_certifiability_support,
    toyCompilerAuditGraph_compositional_safety_support,
    toyCompilerAuditGraph_protocol_nonvacuous]

/-- The toy threshold encoding of the compiler audit check order is
self-legitimate under the Lean-side audit verdict. -/
theorem toy_compiler_audit_is_self_legitimate :
    auditGraph toyCompilerAuditGraph = AuditVerdict.legitimate :=
  toy_compiler_audit_encoding_self_verdict

end Legitimacy
