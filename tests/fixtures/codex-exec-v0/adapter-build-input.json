          "type",
          "link-count",
          "content",
          "stable-metadata"
        ],
        "durability": [
          "sync-file",
          "sync-directory"
        ]
      },
      {
        "id": "pair-order",
        "precondition": "validate-semantic-pair",
        "phases": [
          "prepare-owner-private-sidecar",
          "prepare-public-output",
          "link-owner-private-sidecar",
          "revalidate-committed-sidecar-immediately-before-public-link",
          "link-public-output",
          "revalidate-sidecar-and-public-output"
        ]
      },
      {
        "id": "commit-point",
        "operation": "linkat",
        "replacement": "no-clobber",
        "point": "successful-link"
      },
      {
        "id": "publication-uncertainty",
        "pre_link": "no-created-final-name",
        "post_link": "linked-name-may-remain-on-failure",
        "classes": [
          "output-identity-uncertain",
          "output-integrity-uncertain",
          "durability-uncertain"
        ],
        "cleanup": "do-not-remove-linked-name"
